# Backend Environment Variables
PROJECT_NAME="Kaizenova Backend"
VERSION="1.0.0"

# Database Configuration
# PostgreSQL connection string
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/kaizenova"

# Redis Configuration
# Redis connection URL
REDIS_URL="redis://localhost:6379/0"

# Security
# Secret key for JWT signing (generate using `openssl rand -hex 32`)
SECRET_KEY="supersecretkey"
# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Service (Resend)
# API key from Resend dashboard
RESEND_API_KEY="re_123456789"
# Sender email address
EMAILS_FROM_EMAIL="noreply@kaizenova.com"

# AI Services Integration
# URL for Ollama service
OLLAMA_BASE_URL="http://localhost:11434"
# Whisper STT model configuration
WHISPER_MODEL="large-v3"
# LanguageTool API URL
LANGUAGETOOL_URL="http://localhost:8010/v2/check"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
